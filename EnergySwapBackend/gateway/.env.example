# Meter gateway configuration.
#
# Copy to .env in this directory and fill in. These keys belong to the GRID
# gateway, not to the platform: the EnergySwap API deliberately holds no
# signing identity of its own.
#
# Never commit the filled-in file. It is ignored by .gitignore.

# ── Attestation key (Ed25519) ───────────────────────────────────────────────
# Signs each meter reading. Its PUBLIC key must be configured on the API as
# METER_ORACLE_PUBLIC_KEY. Losing this key loses the ability to attest.
GRID_ATTESTATION_PRIVATE_KEY=

# ── Hedera account key ──────────────────────────────────────────────────────
# Signs the HCS attestation and the HTS energy-token credit. This account
# MUST hold the energy tokens (HTS association) and MUST pay the HBAR fees.
# It must not be the same account as any platform operator.
GRID_ACCOUNT_ID=
GRID_PRIVATE_KEY=

# ── Where to post attestations ──────────────────────────────────────────────
ENERGYSWAP_API_URL=http://localhost:3000

# ── Shared with the API (must match the API's values) ─────────────────────
HCS_TOPIC_ID=
ENERGY_TOKEN_ID=

# ── Local ───────────────────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
# GATEWAY_JOURNAL_PATH=./.settlement-journal.jsonl