# Testnet operator credentials; never commit real private keys.
NODE_ENV=development
PORT=3000
HEDERA_NETWORK=testnet
DATABASE_URL=postgresql://energyswap:change-me@localhost:5432/energyswap
PGSSL=false
CORS_ORIGINS=http://localhost:4300
OPERATOR_ID=0.0.YOUR_OPERATOR_ACCOUNT
OPERATOR_KEY=YOUR_TESTNET_OPERATOR_PRIVATE_KEY

# Existing Testnet resources
HCS_TOPIC_ID=0.0.YOUR_HCS_TOPIC
ENERGY_TOKEN_ID=0.0.YOUR_ENERGY_TOKEN

# Trusted gateway Ed25519 public key (PEM with literal \n between lines).
# Leave unset to keep POST /api/oracle/readings disabled.
METER_ORACLE_PUBLIC_KEY=
